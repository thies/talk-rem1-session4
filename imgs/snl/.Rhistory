trans_residential_fit <-
predict(model_residential, na.rm=FALSE, interval = "confidence", level = 0.80)
trans_residential_fit <- as.data.frame(trans_residential_fit)
trans_residential_fit <- trans_residential_fit %>%
mutate(lwr_pct = (exp(lwr) - exp(fit))/exp(fit)*100,
upr_pct = (exp(upr) - exp(fit))/exp(fit)*100,
range_pct = upr_pct - lwr_pct) %>%
#  rename(log_price_hat = fit) %>%
rename(ln_psm_hat = fit) %>%
mutate(stars = ntile(range_pct, 5))
trans_residential <- trans_residential %>%
cbind(trans_residential_fit) %>%
mutate(price_hat = exp(ln_psm_hat * weighted_area),
price_hat_pct = price_hat/exp(log_sale_price) - 1,
mae_price = abs(price_hat_pct)) %>%
mutate(price_hat_pct = price_hat_pct*100) %>%
mutate(price_mae = abs(price_hat_pct))
summary(trans_residential$price_mae)
trans_residential_fit <-
predict(model_residential, na.rm=FALSE, interval = "confidence", level = 0.80)
