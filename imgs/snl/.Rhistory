# Find 8 nearest transactions, up to 24 months before
# - calculate average price/m2
# - use this to predict value of unit.
find.comps <- function(x, comps=comps.reduced, num.comps=8){
comps <- comps %>% filter(agreement_date_clean <  as.Date(x$agreement_date_clean),
agreement_date_clean >  (as.Date(x$agreement_date_clean)-365*2),
property_kind == x$property_kind,
transaction_type == x$transaction_type,
district_code == x$district_code)
# if there are many comparables, reduce time window.
if(nrow(comps) > 400){
comps <- comps %>% filter(agreement_date_clean >  (as.Date(x$agreement_date_clean)-365))
}
if(nrow(comps) < num.comps){
return(NA)}
else{
x.sp <- st_as_sfc(st_as_binary(st_sfc(st_point(c(x$property_longitude, x$property_latitude))))[[1]], crs = 4326) %>% st_transform(6312)
comps$dist <- st_distance(comps, x.sp)
comps <- comps[order(comps$dist),][1:num.comps,]
comps.aggr <- list(
'psm.comps' = mean(comps$psm, na.rm=TRUE),
'weighted_area.comps' = mean(comps$weighted_area, na.rm=TRUE),
'land_area.comps' = mean(comps$land_area, na.rm=TRUE),
'construction_year.comps' = mean(comps$construction_year, na.rm=TRUE),
'building_ratio.comps' = mean(as.numeric(comps$building_ratio), na.rm=TRUE),
'condition.num.comps' = mean(comps$condition.num, na.rm=TRUE)
)
return( comps.aggr)
}
}
# find 8 comps for each sale... this might take a while.
comps.aggr <- apply(comps[1:10,], 1, find.comps)
comps.aggr.df <- do.call(rbind, comps.aggr) %>% as.data.frame %>% mutate_all( unlist)
summary(comps.aggr.df)
comps <- cbind(comps, comps.aggr.df)
